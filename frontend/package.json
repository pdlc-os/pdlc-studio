{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "format": "prettier --write src/ scripts/",
    "format:check": "prettier --check src/ scripts/",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "playwright:install": "npx playwright install",
    "record-demo": "npx tsx scripts/record-demo.ts",
    "capture-screenshots": "npx tsx scripts/capture-screenshots.ts"
  },
  "dependencies": {
    "@astryxdesign/core": "0.1.8",
    "@astryxdesign/theme-neutral": "0.1.8",
    "@fontsource/arimo": "^5.3.0",
    "@fontsource/bitter": "^5.3.0",
    "@fontsource/eb-garamond": "^5.3.0",
    "@fontsource/gelasio": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/montserrat": "^5.3.0",
    "@fontsource/nunito-sans": "^5.3.0",
    "@fontsource/opendyslexic": "^5.3.0",
    "@stylexjs/stylex": "^0.19.0",
    "dayjs": "^1.11.13",
    "lucide-react": "^1.26.0",
    "marked": "^18.0.7",
    "react": "^19.1.0",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.18.1"
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.220",
    "@eslint/js": "^9.25.0",
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react-swc": "^4.1.0",
    "eslint": "^9.34.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.6.2",
    "tsx": "^4.20.5",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^7.1.6",
    "vitest": "^3.2.4"
  }
}
